        "created_at": "2026-08-31T16:03:17.982997",
        "updated_at": "2026-08-31T16:03:17.982997",
        "author": {
          "id": "32503aeb87e0a4e351b70a17e153330f",
          "source_id": "_menelaus",
          "username": "_menelaus",
          "avatar": "",
          "role": "user"
