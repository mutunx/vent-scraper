      {
        "id": "6d3ea3939a4f394c0f2ec820cd551c91",
        "source_id": "49511218",
        "content": {
          "text": "Hotfixes would go down by probably 50 to 60%. On a bi-weekly release rotation it was not abnormal to see 4 to 5 hot fix versions. In the past year, however, it is not uncommon to do 15 hotfix builds per release. reply",
          "format": "text",
          "media": []
        },
        "created_at": "2026-08-31T16:03:17.982292",
        "updated_at": "2026-08-31T16:03:17.982292",
        "author": {
          "id": "120bef74ee042560c74696633230a0df",
          "source_id": "gottagocode",
          "username": "gottagocode",
