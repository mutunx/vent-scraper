      {
        "id": "36bd2b8b5fe443351931d4cd942781ee",
        "source_id": "49511231",
        "content": {
          "text": "We're an app dev agency so we would inflate our costs and timelines by 5x and we'd never win another bid. reply",
          "format": "text",
          "media": []
